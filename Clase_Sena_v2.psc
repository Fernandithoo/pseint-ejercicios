Algoritmo Clase_Sena_v2
		Definir num1 , num2 Como Entero
		Escribir "Escriba su primer numero: "
		Leer num1
		Escribir "Escriba el segundo numero: "
		Leer num2
		
		//defino las operacines 
		suma = num1 + num2 
		resta = num1 - num2 
		multiplicacion = num1 * num2 
		division = num1 / num2 
		
		Mostrar  "Se mostraran los resultados de las siguientes operaciones" 
		//Defino el resultado de las operaciones
		Mostrar "El resultado de suma es:", suma
		Mostrar "El resultado de resta es:" , resta
		Mostrar "El resultado de multiplicacion es:", multiplicacion
		Mostrar "El resultado de division es:" , division
		
FinAlgoritmo
